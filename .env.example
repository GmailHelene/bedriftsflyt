# MAL — kopier til .env.local og fyll inn der. ALDRI legg hemmeligheter i denne fila.
# .env.local er git-ignorert; .env.example skal KUN ha tomme verdier.

# Database (Postgres) — bruk Railway DATABASE_PUBLIC_URL
DATABASE_URL=
# Sett "false" kun for lokal Postgres uten SSL
DATABASE_SSL=

# Dashbord dev-innlogging (midlertidig — byttes til passordløs)
DASHBOARD_DEV_PASSWORD=

# Signerer innloggings-cookien mot forfalskning (sett en lang tilfeldig streng i produksjon)
SESSION_SECRET=

# KI (kun server-side)
ANTHROPIC_API_KEY=

# Rate-limiting (valgfritt) — hardt tak via Upstash Redis; ellers best-effort in-memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Feilsporing (valgfritt) — Sentry. No-op uten DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# For kildekart-opplasting ved deploy (valgfritt):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Vipps (ePayment + Login). La VIPPS_BASE_URL stå tom for testmiljø (apitest.vipps.no).
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
VIPPS_WEBHOOK_SECRET=
VIPPS_BASE_URL=
# App-URL for Vipps Login redirect (må matche det du registrerer i Vipps-portalen).
# Lokalt: http://localhost:3000 — la stå tom for å utlede fra forespørselen.
APP_BASE_URL=


# Cron-hemmelighet for påminnelser + GDPR-opprydding
CRON_SECRET=

# E-post (Brevo HTTP-API)
BREVO_API_KEY=
# Avsender: "Navn <noreply@dittdomene.no>" eller bare epost. MÅ være verifisert avsender i Brevo.
MAIL_DEFAULT_SENDER=

# SMS (Sveve / LINK Mobility)
SMS_API_KEY=

# Feilsporing (Sentry)
SENTRY_DSN=
